[Unit]
Description=Aqar Monitor - Telegram interactive bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/opc/aqar-monitor
EnvironmentFile=/home/opc/aqar-monitor/.env
ExecStart=/usr/bin/python3.11 /home/opc/aqar-monitor/bot.py
Restart=always
RestartSec=10
User=opc

[Install]
WantedBy=multi-user.target
