# ============================================================
#  مرصد العقارات المصرية — نموذج المتغيرات
#  انسخ الملف ده لـ .env وحط قيمك الفعلية
#  cp .env.example .env
# ============================================================


# ---------- تليجرام (إجباري) ----------
# من @BotFather → /newbot
TELEGRAM_TOKEN=
# من https://api.telegram.org/bot<TOKEN>/getUpdates بعد ما تبعت /start للبوت
TELEGRAM_CHAT_ID=
# اختياري — chat ids مفصولة بفاصلة لمين مسموح له يكلّم البوت التفاعلي
# سيبها فاضية = TELEGRAM_CHAT_ID بس هو المسموح
TELEGRAM_ALLOWED=


# ---------- مفاتيح الذكاء الاصطناعي (لازم واحد على الأقل) ----------
# https://aistudio.google.com/apikey  — 1500 طلب/يوم مجانًا
GEMINI_API_KEY=
# https://console.groq.com/keys  — 14400 طلب/يوم مجانًا وسريع جدًا
GROQ_API_KEY=
# https://cloud.cerebras.ai  — 1M توكن/يوم
CEREBRAS_API_KEY=
# https://openrouter.ai/keys  — موديلات مجانية متعددة
OPENROUTER_API_KEY=


# ---------- يوتيوب (اختياري لكن ضروري للكومنتات) ----------
# https://console.cloud.google.com → فعّل YouTube Data API v3 → Credentials
YOUTUBE_API_KEY=


# ---------- تليجرام الشخصي (اختياري — لفتح جروباتك) ----------
# https://my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=


# ---------- إشعارات فيسبوك عبر الإيميل (اختياري) ----------
FB_EMAIL_ENABLED=false
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
# لـ Gmail: App Password من https://myaccount.google.com/apppasswords
IMAP_PASSWORD=
IMAP_FOLDER=INBOX


# ---------- إعدادات متقدمة (اختيارية) ----------
# فحص المصادر الرسمية كل كام ثانية في وضع --daemon
WATCH_INTERVAL_SECONDS=45
# مستوى التنبيه: any / cross / confirmed
INTEL_ALERT_LEVEL=any
# تفعيل رادار الإشارات المبكرة
INTEL_ENABLED=true
# إرسال رسائل تليجرام (خليها false للاختبار)
SEND_TELEGRAM=true
# طباعة تفاصيل التشغيل
VERBOSE=true
# سيرفر RSSHub بديل (لو شغّلت واحد خاص بيك)
RSSHUB_BASE=https://rsshub.app
